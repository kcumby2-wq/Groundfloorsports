# SubjectReport ops validation environment template
# Copy values from your Supabase project settings before live checks.

# Required for live checks
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Preferred mode (recommended): service role key for non-interactive CI/live diagnostics
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Fallback mode (manual session-based):
# SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY
# SUPABASE_AUTH_TOKEN=YOUR_AUTHENTICATED_JWT

# Notes:
# - validate:ops and validate:marketplace-suite run without these vars, but live checks will be skipped.
# - Use service role key only in trusted environments (local secure shell or CI secrets).
