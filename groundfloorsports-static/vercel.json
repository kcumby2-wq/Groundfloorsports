{
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/marketplace",
      "destination": "/marketplace.html"
    },
    {
      "source": "/sign-in",
      "destination": "/sign-in.html"
    },
    {
      "source": "/sign-up",
      "destination": "/sign-up.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
