NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Optional: enables checkout order persistence in Supabase (fallback is local data/orders.json)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Stripe webhook processing
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe Connect (optional for marketplace payouts)
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxx
STRIPE_CONNECT_DEFAULT_DESTINATION_ACCOUNT=acct_xxx
STRIPE_CONNECT_PLATFORM_FEE_PERCENT=10

# Optional: specific Stripe Price IDs for Subjectreport plans
STRIPE_SUBJECTREPORT_TRANSCRIPT_PRICE_ID=price_xxx
STRIPE_SUBJECTREPORT_PROGRAM_PRICE_ID=price_xxx
STRIPE_SUBJECTREPORT_FULL_PRICE_ID=price_xxx
STRIPE_SUBJECTREPORT_PROSPECT_PRICE_ID=price_xxx
